import org.springframework.boot.SpringApplication;
import org.springframework.boot.autoconfigure.SpringBootApplication;
import org.springframework.web.bind.annotation.*;
import java.time.LocalDateTime;

@SpringBootApplication
@RestController
@RequestMapping("/api/logs")
public class SecurityLogService {

    public static void main(String[] args) {
        SpringApplication.run(SecurityLogService.class, args);
    }

    // Endpoint que recebe o alerta do Python
    @PostMapping("/alert")
    public String receiveAlert(@RequestBody ThreatAlert alert) {
        // Na prática, aqui você salvaria no Elasticsearch ou banco de dados
        System.out.println("[" + LocalDateTime.now() + "] ALERTA REGISTRADO: " 
                           + alert.getType() + " vindo de " + alert.getIp());
        return "Log arquivado com sucesso";
    }
}

// Classe de modelo para o alerta
class ThreatAlert {
    private String ip;
    private String type; // ex: "Port Scan", "DDoS", "Brute Force"

    // Getters e Setters
    public String getIp() { return ip; }
    public void setIp(String ip) { this.ip = ip; }
    public String getType() { return type; }
    public void setType(String type) { this.type = type; }
}
